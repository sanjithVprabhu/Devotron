# ──────────────────────────────────────────────────────────────────────
# VEDA — environment template
# Copy to .env and fill in. Never commit .env.
# Production secrets live in Azure Key Vault; this file is for local dev.
# ──────────────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=debug
APP_REGION=in-south
APP_BASE_URL=http://localhost:3000

# ── LLM provider routing ──
# Default provider for all tasks. "openai" (direct) is the v1 default.
# Use "mock" for keyless local demos — emits canned harness XML.
# Other values: "anthropic", "azure_openai".
LLM_DEFAULT_PROVIDER=openai

# ── OpenAI (direct, default) ──
OPENAI_API_KEY=
# OPENAI_BASE_URL=                # only set for proxies / OpenAI-compatible endpoints
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_CHEAP_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Anthropic (fallback) ──
ANTHROPIC_API_KEY=
ANTHROPIC_REASONING_MODEL=claude-sonnet-4-6
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5-20251001

# ── Azure OpenAI (alternate fallback) ──
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_EMBED=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Sarvam AI (optional, India-language quality) ──
SARVAM_API_KEY=

# ── Postgres (Neon in prod, local Postgres for dev) ──
POSTGRES_URL=postgresql://veda:veda@localhost:5432/veda
POSTGRES_URL_RO=postgresql://veda:veda@localhost:5432/veda

# ── MongoDB Atlas (or local Mongo for dev) ──
MONGO_URL=mongodb://veda:veda@localhost:27017/?authSource=admin
MONGO_DB_PREFIX=tenant_

# ── Qdrant (Cloud in prod, local docker for dev) ──
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Redis (Azure Cache in prod, local Redis for dev) ──
REDIS_URL=redis://localhost:6379

# ── Kafka (Confluent Cloud in prod, Redpanda for dev) ──
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=veda-local
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Azure Blob Storage ──
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_MEDIA=veda-media
AZURE_BLOB_CONTAINER_UPLOADS=veda-uploads

# ── WhatsApp provider routing ──
# "aisensy" for the pilot (BSP). "meta_direct" once we have direct Meta access.
WA_PROVIDER=aisensy

# ── AiSensy (pilot BSP) ──
AISENSY_BASE_URL=https://apis.aisensy.com
AISENSY_BUSINESS_ID=
AISENSY_BUSINESS_API_PWD=
# Per-tenant project credentials (project_id, project_api_pwd, webhook_shared_secret)
# are NOT set here — they live in business.whatsapp_numbers per tenant.

# ── Meta direct (post-pilot) ──
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=replace_me_with_a_random_string
META_GRAPH_VERSION=v22.0
META_SYSTEM_USER_TOKEN=
VEDA_WABA_ID=
VEDA_PHONE_NUMBER_ID=
VEDA_PHONE_NUMBER=

# ── Tenant secret encryption ──
# Base64 of 32 random bytes. Encrypts per-tenant API passwords stored in Postgres.
# Generate: openssl rand -base64 32
TENANT_SECRET_KEY_B64=

# ── Twitter / X API ──
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_USER_ID=
TWITTER_HANDLE=veda_bot

# ── Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Speech-to-text (voice notes) ──
# Pick one — Azure Speech (default) or Sarvam (better Indic)
SPEECH_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# ── Auth.js / dashboard auth ──
AUTH_SECRET=
AUTH_URL=http://localhost:3001
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# India SMS OTP (MSG91)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── Internal service tokens (rotated automatically in prod) ──
INTERNAL_SERVICE_TOKEN=replace_me_with_a_random_string

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=veda
GRAFANA_CLOUD_API_KEY=

# ── Cost guardrails (defaults applied per tenant unless Blueprint overrides) ──
DEFAULT_DAILY_BUDGET_INR=50
DAEMON_DEFAULT_DAILY_BUDGET_INR=15
